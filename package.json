{
  "name": "chess-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/contracts", "packages/domain", "apps/server", "apps/web"],
  "engines": { "node": ">=22.12.0 <23 || >=24 <25", "npm": ">=10" },
  "scripts": {
    "build:packages": "npm run build --workspace=@chess/contracts && npm run build --workspace=@chess/domain",
    "predev": "npm run build:packages",
    "dev": "concurrently --kill-others --names server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --workspace=@chess/server",
    "dev:web": "npm run dev --workspace=@chess/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:check": "npm run db:check --workspace=@chess/server",
    "db:migrate": "npm run db:migrate --workspace=@chess/server",
    "start:server": "npm run start --workspace=@chess/server",
    "preview:web": "npm run preview --workspace=@chess/web"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
