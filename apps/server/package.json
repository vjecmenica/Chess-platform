{
  "name": "@chess/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "db:check": "tsx src/db-cli.ts check",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "explorer:import": "tsx src/explorer-cli.ts",
    "explorer:diagnose": "tsx src/explorer-diagnostic-cli.ts"
  },
  "dependencies": {
    "@chess/contracts": "0.0.0",
    "@chess/domain": "0.0.0",
    "@fastify/cookie": "11.1.3",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.7",
    "nodemailer": "10.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1"
  }
}
