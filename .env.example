# Copy to .env in the repository root. Supply your own local password.
POSTGRES_USER=chess
POSTGRES_DB=chess
POSTGRES_PASSWORD=
# Percent-encode special characters in the password when building this URL.
DATABASE_URL=
# Example shape: postgresql://chess:YOUR_PASSWORD@127.0.0.1:5432/chess
HOST=127.0.0.1
PORT=3001
# Development only. Production keeps public Rated challenges disabled.
ENABLE_DEV_RATED_CHALLENGES=false
# Optional. Comma-separated OS users authorized for the internal review CLI.
ADJUDICATION_REVIEWERS=
# Optional: separate disposable database for npm run test:db.
TEST_DATABASE_URL=

# Email is optional and disabled by default. See docs/accounts.md.
MAIL_TRANSPORT=disabled
# Browser-facing origin, not the API port. HTTPS is required outside local development.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# MAIL_TRANSPORT=local writes private test messages under .local/account-mail/ (never served over HTTP).
# MAIL_TRANSPORT=smtp requires these server-only values:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Profile avatars default to .local/avatars. Use a durable mounted directory in production.
# AVATAR_DIRECTORY=/path/to/chess-avatars
# For a private S3-compatible bucket instead, set all four values below.
# AVATAR_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AVATAR_S3_BUCKET=chess-avatars
# AVATAR_S3_ACCESS_KEY_ID=
# AVATAR_S3_SECRET_ACCESS_KEY=
# AVATAR_S3_REGION=auto
