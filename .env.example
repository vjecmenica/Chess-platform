# Copy to .env in the repository root. Supply your own local password.
POSTGRES_USER=chess
POSTGRES_DB=chess
POSTGRES_PASSWORD=
# Percent-encode special characters in the password when building this URL.
DATABASE_URL=
# Example shape: postgresql://chess:YOUR_PASSWORD@127.0.0.1:5432/chess
HOST=127.0.0.1
PORT=3001
# Optional: separate disposable database for npm run test:db.
TEST_DATABASE_URL=

# Email is optional and disabled by default. See docs/accounts.md.
MAIL_TRANSPORT=disabled
# Browser-facing origin, not the API port. HTTPS is required outside local development.
PUBLIC_ORIGIN=http://127.0.0.1:5173
# MAIL_TRANSPORT=local writes private test messages under .local/account-mail/ (never served over HTTP).
# MAIL_TRANSPORT=smtp requires these server-only values:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
